{
  "name": "gcode_gui",
  "version": "2.0.21",
  "description": "A professional G-code generator for 24-well plate bioprinting applications with live visual preview and comprehensive features.",
  "main": "electron/main.js",
  "scripts": {
    "sync:core": "node scripts/sync-gcode-core.js",
    "export:starts": "node scripts/export-well-starts.js",
    "sync:motion": "node scripts/sync-gcode-motion.js",
    "sync:pico-sim": "node scripts/sync-pico-simulator.js",
    "sync": "npm run sync:core && npm run sync:motion && npm run sync:pico-sim",
    "electron": "npm run sync && node scripts/run-electron.js",
    "dist:mac": "npm run sync && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --publish never",
    "dist:win": "npm run sync && node scripts/run-electron-builder.js --win --publish never",
    "test": "node scripts/check-renderer-core-imports.js && node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.ariellewolter.gcodegui",
    "productName": "G-Code Generator",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron-build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/preload.js",
      "electron/shared/**",
      "electron/renderer/gcode-core.js"
    ],
    "mac": {
      "icon": "electron-build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "electron-build/entitlements.mac.plist",
      "entitlementsInherit": "electron-build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariellewolter/GCODE-GUI-Electron.git"
  },
  "keywords": [],
  "author": "Evonyx by Arielle Wolter",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ariellewolter/GCODE-GUI-Electron/issues"
  },
  "homepage": "https://github.com/ariellewolter/GCODE-GUI-Electron#readme",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8"
  }
}
