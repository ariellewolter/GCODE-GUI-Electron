# =============================================================================
# COPY THIS FILE (do not edit this example in place)
# =============================================================================
#
#   cp .github/secrets.env.example .github/secrets.env
#   open -e .github/secrets.env
#
# Fill in the five lines below, then run:
#   ./scripts/setup-github-secrets.sh
#
# Full instructions: .github/SECRETS_SETUP.md
# =============================================================================

# 1) Your Apple ID email (login for appleid.apple.com)
#    Example: APPLE_ID=jane.smith@gmail.com
APPLE_ID=

# 2) App-specific password from appleid.apple.com → Sign-In and Security
#    (NOT your normal Apple password). Looks like: abcd-efgh-ijkl-mnop
#    Example: APPLE_APP_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
APPLE_APP_SPECIFIC_PASSWORD=

# 3) Apple Developer Team ID (10 characters). This project uses:
APPLE_TEAM_ID=74MA96HS7Z

# 4) Password you chose when you exported the .p12 certificate file
#    Example: MACOS_CERT_PASSWORD=SomePasswordYouChoseIn2024
MACOS_CERT_PASSWORD=

# 5) Full path to your Developer ID .p12 file on this Mac
#    Tip: drag the file into Terminal to paste the path
#    Example: MACOS_CERT_P12_PATH=/Users/jane/Documents/DeveloperID.p12
MACOS_CERT_P12_PATH=
